@user = test1
@phone = 01000000000

### 유저 생성
POST {{base-url}}/users/join/signup
Content-Type: application/json

{
  "phoneNumber": {{phone}},
  "username": "테스트 유저({{user}})",
  "email": "{{user}}@test.com",
  "birthDay": "1997-11-11",
  "gender": "MALE",
  "preferGender": "BISEXUAL",
  "introduction": "저는 테스트 유저 입니다.",
  "agreement": {
    "serviceUseAgree" : true,
    "personalPrivacyInfoAgree" : true,
    "locationServiceAgree" : true,
    "marketingAgree": true
  },
  "locationRequest": {
    "address": "서울특별시 힘찬구 열심동",
    "regionCode": 110444103,
    "lat": 37.5,
     "lon": 127.7
  },
  "photoList": [
  "data:image/jpeg;base64,",
  "data:image/jpeg;base64,"
  ],
  "interestList": [1,2,3],
  "idealTypeList": [1,2,3],
  "snsType": "NORMAL",
  "snsUniqueId": "{{user}}",
  "tall": 170,
  "smoking": "NONE",
  "drinking": "NONE",
  "religion": "NONE"
}